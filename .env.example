# Local PostgreSQL Database Configuration (Docker)
POSTGRES_USER=japan_user
POSTGRES_PASSWORD=japan_dev_pass
POSTGRES_DB=japan_imports_dev
DATABASE_URL=postgresql://japan_user:japan_dev_pass@db:5432/japan_imports_dev

# Remote Neon Database (Cloud PostgreSQL)
NEON_DATABASE_URL=postgresql://user:password@ep-sample-neon-pooler.region.aws.neon.tech/neondb?sslmode=require

# App Settings
APP_ENV=development
REDIS_URL=redis://localhost:6379
USD_KES_FALLBACK=130.0
SCRAPE_DELAY_SECONDS=2.0
