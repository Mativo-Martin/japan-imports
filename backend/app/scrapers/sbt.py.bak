import re, json, logging
import httpx
from bs4 import BeautifulSoup
from tenacity import retry, stop_after_attempt, wait_exponential, retry_if_exception_type
from datetime import datetime
from app.database import SessionLocal
from app.models.car_listings import CarListing

logger = logging.getLogger(__name__)

FUEL_MAP  = {"gasoline":"petrol","petrol":"petrol","diesel":"diesel",
             "hybrid":"hybrid","electric":"electric","ev":"electric"}
TRANS_MAP = {"at":"automatic","auto":"automatic","automatic":"automatic",
             "mt":"manual","manual":"manual","cvt":"cvt"}

# Makes confirmed from live SBT site
SBT_MAKES = [
    "TOYOTA", "NISSAN", "HONDA", "MAZDA",
    "SUBARU", "SUZUKI", "MITSUBISHI", "DAIHATSU",
]


class SBTScraper:
    """
    SBT Japan search — confirmed live URL:
      https://www.sbtjapan.com/used-cars/search
    Params (confirmed from live HTML form):
      make[]=TOYOTA  year_from=2018  year_to=2025  currency=USD  p=N
    """
    SOURCE   = "sbt"
    BASE_URL = "https://www.sbtjapan.com/used-cars/search"
    HEADERS  = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/124.0.0.0 Safari/537.36"
        ),
        "Accept":          "text/html,application/xhtml+xml,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9",
        "Referer":         "https://www.sbtjapan.com/",
    }
    DELAY = 2.5

    @retry(
        stop=stop_after_attempt(4),
        wait=wait_exponential(multiplier=1, min=3, max=30),
        retry=retry_if_exception_type((httpx.HTTPStatusError, httpx.TimeoutException)),
        reraise=True,
    )
    async def _fetch(self, params: dict) -> str:
        import asyncio
        await asyncio.sleep(self.DELAY)
        async with httpx.AsyncClient(
            headers=self.HEADERS, timeout=30.0, follow_redirects=True
        ) as client:
            r = await client.get(self.BASE_URL, params=params)
            r.raise_for_status()
            logger.info("[sbt] GET %s → %d", r.url, r.status_code)
            return r.text

    def _find_cards(self, soup: BeautifulSoup) -> list:
        # BEM pattern: input.card-product__favorite-icon → parent is .card-product
        # Always exclude bare [data-car-id] — that matches the <input> checkbox, not the card
        strategies = [
            # BEM container (confirmed from live HTML: input class="card-product__favorite-icon")
            (".card-product",           lambda s: s.select(".card-product")),
            (".card-product__wrapper",  lambda s: s.select(".card-product__wrapper")),
            # Other common SBT patterns
            (".car-item",               lambda s: s.select(".car-item")),
            (".stock-car-box",          lambda s: s.select(".stock-car-box")),
            (".carBox",                 lambda s: s.select(".carBox")),
            ("article.car-card",        lambda s: s.select("article.car-card")),
            # data-car-id on a div/li/article (NOT input)
            ("div/li[data-car-id]",     lambda s: [
                el for el in s.select("[data-car-id]")
                if el.name in ("div", "li", "article")
            ]),
            # Heuristic: container holds a price and a car link
            ("heuristic",               lambda s: [
                el for el in s.select("div,li,article")
                if el.select_one("a[href*='used-cars']")
                and el.select_one("[class*='price'],[class*='Price']")
                and len(el.get("class", [])) > 0
            ]),
        ]
        for name, fn in strategies:
            result = fn(soup)
            if result:
                logger.info("[sbt] selector '%s' → %d cards", name, len(result))
                return result
        logger.warning("[sbt] _find_cards: 0 cards — check /tmp/sbt_debug.html")
        return []

    def _parse_card(self, card, make: str) -> dict | None:
        try:
            # ID: prefer stock-value span, fallback to input data-car-id or URL
            sid = ""
            sv = card.select_one(".card-product__stock-value")
            if sv:
                sid = sv.get_text(strip=True)
            if not sid:
                inp = card.select_one("input[data-car-id]")
                if inp:
                    sid = inp.get("data-car-id", "")
            if not sid:
                a = card.select_one("a[href*='used-cars']")
                if a:
                    m = re.search(r"/([A-Z]{2}\d+|\d{4,})", a.get("href", ""), re.I)
                    sid = m.group(1) if m else ""
            if not sid:
                return None

            # Price — first .card-product__price span = vehicle price (second = total)
            price = None
            price_node = card.select_one(".card-product__vehicle-price .card-product__price")
            if not price_node:
                price_node = card.select_one(".card-product__price")
            if price_node:
                raw = price_node.get_text().replace(",", "").strip()
                m = re.search(r"\d[\d.]*", raw)
                if m:
                    v = float(m.group())
                    if 300 < v < 500_000:
                        price = v
            if not price:
                return None

            # Year — embedded in .card-product__product: "2019/3 TOYOTA AQUA..."
            year = None
            title_node = card.select_one(".card-product__product")
            if title_node:
                m = re.search(r"(20\d{2})", title_node.get_text())
                if m:
                    year = int(m.group())
            if not year:
                m = re.search(r"(20\d{2})", card.get_text())
                year = int(m.group()) if m else None
            if not year or year < 2018:  # no upper cap — accept any future year
                return None

            # Model — strip "YYYY/MM " prefix from product title
            model = ""
            if title_node:
                raw_title = title_node.get_text(strip=True)
                # "2019/3 TOYOTA AQUA S" → "TOYOTA AQUA S" → strip make → "AQUA S"
                model = re.sub(r"^\d{4}/\d{1,2}\s*", "", raw_title)
                model = re.sub(r"^" + re.escape(make.upper()) + r"\s*", "", model, flags=re.I).strip()

            # Status specs: use modifier classes .-mileage, .-engine-capacity, etc.
            def _status(modifier):
                node = card.select_one(f".card-product__status.{modifier}")
                return node.get_text(strip=True) if node else ""

            mileage = None
            raw_mileage = _status("-mileage")
            m = re.search(r"[\d,]+", raw_mileage.replace(",", ""))
            if m:
                mileage = int(m.group())

            # Engine: "1,200cc" → 1200
            engine = None
            raw_eng = _status("-engine-capacity")
            m = re.search(r"([\d,]+)\s*cc", raw_eng.replace(",", ""), re.I)
            if m:
                engine = int(m.group(1))

            # Fuel: "HYBRID(PETROL)" / "PETROL" / "DIESEL"
            raw_fuel = _status("-fuel-type").lower()
            if "hybrid" in raw_fuel:
                fuel_type = "hybrid"
            elif "diesel" in raw_fuel:
                fuel_type = "diesel"
            elif "electric" in raw_fuel or "ev" in raw_fuel:
                fuel_type = "electric"
            else:
                fuel_type = "petrol"

            # Transmission: "AT" / "MT" / "CVT"
            raw_trans = _status("-transmission").lower()
            trans = next((v for k, v in TRANS_MAP.items() if k in raw_trans), "automatic")

            a_tag = card.select_one("a.card-product__wrap[href]")
            url   = ("https://www.sbtjapan.com" + a_tag["href"]) if a_tag else None
            imgs  = [img["src"] for img in card.select("img[src]")
                     if "sbtjapan.com/img/carphoto" in img.get("src", "")]

            return {
                "source_id":    f"sbt_{sid}",
                "url":          url,
                "make":         make.title(),
                "model":        model or "",
                "year":         year,
                "mileage_km":   mileage,
                "engine_cc":    engine,
                "fuel_type":    fuel_type,
                "transmission": trans,
                "body_type":    "",
                "price_usd":    price,
                "images":       json.dumps(imgs[:5]),
                "raw_data":     str(card)[:2000],
            }
        except Exception as e:
            logger.debug("[sbt] card parse error: %s", e)
            return None

    def _text(self, el, selectors: str, default=None):
        for sel in selectors.split(","):
            node = el.select_one(sel.strip())
            if node:
                return node.get_text(strip=True)
        return default

    def _save_batch(self, listings: list) -> int:
        if not listings:
            return 0
        db = SessionLocal(); new = 0
        try:
            for item in listings:
                existing = db.query(CarListing).filter_by(source_id=item["source_id"]).first()
                if existing:
                    existing.price_usd = item["price_usd"]
                else:
                    valid = {k: v for k, v in item.items()
                             if k in CarListing.__table__.columns.keys()}
                    db.add(CarListing(source=self.SOURCE, scraped_at=datetime.utcnow(), **valid))
                    new += 1
            db.commit()
        except Exception as e:
            db.rollback()
            logger.error("[sbt] DB error: %s", e)
        finally:
            db.close()
        return new

    async def run(self, max_pages: int = 50) -> int:
        import asyncio
        total = 0
        for make in SBT_MAKES:
            logger.info("[sbt] scraping make: %s", make)
            for page in range(1, max_pages + 1):
                params = {
                    "make[]":    make,
                    "year_from": "2018",   # no year_to cap — accept all recent stock
                    "currency":  "USD",
                    "p":         str(page),
                }
                try:
                    html  = await self._fetch(params)
                    soup  = BeautifulSoup(html, "html.parser")
                    cards = self._find_cards(soup)
                    if not cards:
                        logger.info("[sbt] %s p%d — no cards", make, page)
                        break
                    listings = [c for c in (self._parse_card(card, make) for card in cards) if c]
                    saved    = self._save_batch(listings)
                    total   += saved
                    logger.info("[sbt] %s p%d: %d cards, %d saved", make, page, len(cards), saved)

                    # Stop if no next-page link
                    if not soup.select_one("a[rel='next'],.pagination .next,a.next"):
                        break
                except Exception as e:
                    logger.error("[sbt] %s p%d: %s", make, page, e)
                    break
                await asyncio.sleep(self.DELAY)
        return total